generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(GURU)
  kelasId   String?
  kelas     Kelas?    @relation(fields: [kelasId], references: [id])
  createdAt DateTime  @default(now())
  absensi   Absensi[]
}

model Kelas {
  id        String    @id @default(cuid())
  nama      String
  tingkat   String
  jurusan   String?
  tahunAjar String
  siswa     Siswa[]
  absensi   Absensi[]
  guru      User[]
  riwayatSiswa RiwayatKelasSiswa[]
  createdAt DateTime  @default(now())
}

model Siswa {
  id           String       @id @default(cuid())
  nis          String       @unique
  nama         String
  jenisKelamin JenisKelamin
  tanggalLahir DateTime?
  alamat       String?
  foto         String?
  status       StatusSiswa  @default(AKTIF)
  kelasId      String
  kelas        Kelas        @relation(fields: [kelasId], references: [id], onDelete: Restrict)
  absensi      Absensi[]
  riwayatKelas RiwayatKelasSiswa[]
  createdAt    DateTime     @default(now())
}

model Absensi {
  id         String        @id @default(cuid())
  tanggal    DateTime      @db.Date
  status     StatusAbsensi
  keterangan String?
  siswaId    String
  siswa      Siswa         @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  kelasId    String
  kelas      Kelas         @relation(fields: [kelasId], references: [id], onDelete: Restrict)
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([siswaId, tanggal])
  @@index([kelasId, tanggal])
  @@index([tanggal])
}

model RiwayatKelasSiswa {
  id        String             @id @default(cuid())
  siswaId   String
  siswa     Siswa              @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  kelasId   String?
  kelas     Kelas?             @relation(fields: [kelasId], references: [id], onDelete: SetNull)
  tahunAjar String
  status    StatusRiwayatKelas @default(AKTIF)
  catatan   String?
  createdAt DateTime           @default(now())

  @@index([siswaId, tahunAjar])
  @@index([tahunAjar])
}

enum Role {
  ADMIN
  GURU
}

enum StatusAbsensi {
  HADIR
  SAKIT
  IZIN
  ALPHA
}

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

enum StatusSiswa {
  AKTIF
  LULUS
  PINDAH
  KELUAR
}

enum StatusRiwayatKelas {
  AKTIF
  NAIK
  TINGGAL
  LULUS
  PINDAH
  KELUAR
}
